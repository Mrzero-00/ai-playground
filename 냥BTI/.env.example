# App in Toss console values (required only for `pnpm build:ait`)
AIT_APP_NAME=
AIT_DISPLAY_NAME=냥BTI
AIT_PRIMARY_COLOR=#ff7a59
AIT_ICON_URL=

# Client-visible ad settings. Keep disabled for normal browser development.
# test: official test ID, production: console-issued ID, disabled: no ad
NEXT_PUBLIC_TOSS_AD_MODE=disabled
NEXT_PUBLIC_TOSS_AD_GROUP_ID=
