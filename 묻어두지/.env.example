# Optional: the app detects the Mac's address from the Expo development server.
# If your phone cannot connect, set your Mac's Wi-Fi LAN IP here.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8787

# Optional: needed only for Google Maps on Android. Rebuild after changing.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Development server only. Do not put private keys into EXPO_PUBLIC_* variables.
# PORT=8787
# HOST=0.0.0.0
