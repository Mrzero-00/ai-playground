# API 서버 주소. 비워 두면: localhost 웹·Expo 개발 서버에서는 :8787 을 추정하고,
# 배포된 웹(Vercel)에서는 서버 없이 시드 데이터를 가진 로컬 백엔드로 돈다.
# 폰에서 Mac 서버에 못 붙으면 Mac 의 Wi-Fi LAN IP 를 적는다.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8787

# 서버(pnpm server)가 허용할 추가 Origin (쉼표 구분). localhost 는 항상 허용.
# CORS_ORIGINS=https://mudeodooji.vercel.app
# 미디어 서명 URL 비밀. 비우면 켤 때마다 새로 만든다(재시작 뒤 기존 URL 무효).
# MEDIA_SIGNING_SECRET=
# 소셜 로그인. 켠 제공자만 GET /auth/me 의 providers 에 나온다.
# 구글: 받아들일 OAuth 클라이언트 ID(iOS·Android·웹), 쉼표 구분.
# GOOGLE_CLIENT_IDS=
# 애플: 받아들일 번들 ID·Services ID, 쉼표 구분.
# APPLE_CLIENT_IDS=
# 카카오: 1 이면 켠다(서버 비밀 불필요).
# KAKAO_ENABLED=1
# 이름만으로 로그인(dev). 로컬 테스트 전용, 공개 서버에서 켜지 말 것.
# DEV_LOGIN=1

# Google Maps keys for the town map on phones (react-native-maps, Google provider).
# Restrict each key to the platform: iOS bundle ID / Android package + SHA-1.
# Without them iOS shows Apple's muted map and Android shows a link instead of a map.
# EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Development server only.
# PORT=8787
# HOST=0.0.0.0

# 소셜 로그인 (앱). 서버 쪽 GOOGLE_CLIENT_IDS / APPLE_CLIENT_IDS / KAKAO_ENABLED 와 짝을 맞춘다.
# Google Cloud Console → OAuth 클라이언트 (웹 / iOS / Android 각각)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Kakao Developers → 앱 키 → REST API 키. 플랫폼에 웹·앱 스킴(mudeodooji://) 리다이렉트를 등록한다.
# EXPO_PUBLIC_KAKAO_REST_KEY=
