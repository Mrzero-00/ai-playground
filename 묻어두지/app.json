{
  "expo": {
    "name": "묻어두지",
    "slug": "mudeodooji",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mudeodooji",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mudeodooji.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.mudeodooji.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F0E3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "약속 장소를 등록하고 현장에서 확인하기 위해 현재 위치를 사용합니다.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "캡슐에 넣을 목소리를 녹음하기 위해 마이크를 사용합니다."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "캡슐에 넣을 사진과 동영상을 고르기 위해 사진 보관함을 사용합니다.",
          "cameraPermission": "캡슐에 넣을 사진과 동영상을 찍기 위해 카메라를 사용합니다.",
          "microphonePermission": "동영상의 소리를 녹음하기 위해 마이크를 사용합니다."
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": "AR"
          },
          "ios": {
            "cameraUsagePermission": "심어 둔 캡슐을 카메라로 찾기 위해 카메라를 사용합니다.",
            "microphoneUsagePermission": "AR 장면에서 소리를 녹음하기 위해 마이크를 사용합니다.",
            "photosPermission": "AR 장면을 사진으로 남기기 위해 사진 보관함을 사용합니다.",
            "savephotosPermission": "AR 장면을 사진으로 저장하기 위해 사진 보관함을 사용합니다."
          },
          "iosLinkage": "static"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "splash": null
  }
}