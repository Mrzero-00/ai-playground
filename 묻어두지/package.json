{
  "name": "mudeodooji",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@expo-google-fonts/gowun-dodum": "^0.4.1",
    "@expo-google-fonts/jua": "^0.4.1",
    "@expo-google-fonts/nanum-gothic": "^0.4.0",
    "@expo-google-fonts/nanum-myeongjo": "^0.4.1",
    "@expo/ui": "~57.0.14",
    "@react-native-picker/picker": "2.11.4",
    "@reactvision/react-viro": "3.0.3",
    "@reactvision/viro-web-renderer": "^1.0.1",
    "expo": "~57.0.18",
    "expo-apple-authentication": "~57.0.2",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.16",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.14",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "maplibre-gl": "^6.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepare:map": "node scripts/prepare-map-assets.mjs",
    "postinstall": "node scripts/prepare-map-assets.mjs",
    "start": "expo start --dev-client",
    "prestart": "node scripts/prepare-map-assets.mjs",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "preweb": "node scripts/prepare-map-assets.mjs",
    "build:web": "node scripts/prepare-map-assets.mjs && expo export --platform web --output-dir dist",
    "server": "tsx --env-file-if-exists=.env server/index.ts",
    "server:watch": "tsx watch --env-file-if-exists=.env server/index.ts",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.mjs && tsx --test server/*.test.ts",
    "test:unit": "tsx --test tests/*.test.mjs",
    "test:server": "tsx --test server/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "private": true
}
