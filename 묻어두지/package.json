{
  "name": "mudeoduji",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "scripts": {
    "prepare:map": "node scripts/prepare-map-assets.mjs",
    "postinstall": "npm run prepare:map",
    "prestart": "npm run prepare:map",
    "preweb": "npm run prepare:map",
    "export": "npm run prepare:map && expo export --platform all",
    "start": "expo start --dev-client",
    "web": "expo start --web --port 8081",
    "ios": "bash scripts/ios.sh",
    "ios:check": "bash scripts/ios.sh --check",
    "android": "RCT_NEW_ARCH_ENABLED=1 expo run:android --device",
    "server": "tsx --env-file-if-exists=.env server/index.ts",
    "server:watch": "tsx watch --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prebuild": "expo prebuild --no-install",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@reactvision/react-viro": "2.57.3",
    "expo": "~55.0.31",
    "expo-audio": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-location": "~55.1.14",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.21",
    "maplibre-gl": "6.10.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
