# API
PORT=4200
DATABASE_PATH=.data/ppira.db
WEB_ORIGIN=http://localhost:5174

# 로컬에서는 10~30초, 운영에서는 30분~2시간을 권장합니다.
FLIGHT_MIN_SECONDS=10
FLIGHT_MAX_SECONDS=30
LANDING_TTL_SECONDS=86400
MAX_LANDING_SEQUENCE=3
ALLOW_SIMULATED_LOCATION=true
ALLOW_SIMULATED_PURCHASE=true

# 운영 인앱결제 주문 검증용 mTLS 인증서
IAP_MTLS_CERT_PATH=
IAP_MTLS_KEY_PATH=
IAP_MTLS_KEY_PASSPHRASE=
FLYER_ENCRYPTION_KEY=replace-with-kms-managed-secret

# Web
VITE_API_BASE_URL=http://localhost:4200
