<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.coin-trend.live</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/sonsang-il/autoCoin/코인추세추종/scripts/live.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/sonsang-il/autoCoin/코인추세추종</string>
  <!-- 30분마다(매시 7분·37분). 09:07 은 하루 몫(사고판다), 13:07·17:07·21:07·01:07·05:07 은 장중 확인(4시간봉으로 사기만)도 하고,
       그 밖의 실행은 가진 코인의 손절만 본다(가진 코인이 없으면 아무것도 부르지 않고 끝난다). 하루 몫이 실패했으면 다음 4시간 칸의 첫 실행이 다시 한다.
       잠자기 중이면 깨어날 때 실행되는데, 4시간 칸이 시작한 지 1시간이 넘었으면 live.py 가 사는 확인은 건너뛴다 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>7</integer></dict>
    <dict><key>Minute</key><integer>37</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/sonsang-il/autoCoin/코인추세추종/live/logs/live.log</string>
  <key>StandardErrorPath</key><string>/Users/sonsang-il/autoCoin/코인추세추종/live/logs/live.err</string>
</dict>
</plist>
